# Groq (OpenAI-kompatibel). Der Schlüssel bleibt auf dem Server und erreicht nie den Browser.
GROQ_API_KEY=
# Optional: Modelle in Prioritätsreihenfolge, kommagetrennt. Bei Rate-Limit wird das nächste versucht.
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b
# Optional: anderer OpenAI-kompatibler Endpunkt, z. B. ein selbst betriebenes Modell.
# GROQ_BASE_URL=https://api.groq.com/openai/v1
